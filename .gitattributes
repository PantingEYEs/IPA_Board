# Preserve byte-exact model chunks and upstream artifacts.
app/src/main/assets/engines/semantic/model.part* binary
app/src/main/assets/engines/semantic/*.onnx binary
app/libs/*.aar binary
# Upstream license/notice text is retained verbatim and covered by the resource lockfile.
app/src/main/assets/licenses/* -whitespace
# Preserve the pinned Mozc notices/build records byte-for-byte, including upstream formatting.
app/src/main/assets/licenses/mozc/** -text -whitespace
tools/mozc/*.json -text -whitespace
# Keep the source-built Extensions notices and pinned build records byte-exact.
app/src/main/assets/licenses/onnx-extensions/** -text -whitespace
tools/onnx-extensions/** -text -whitespace
