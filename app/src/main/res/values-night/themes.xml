<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.IPA_Board" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.IPA_Board.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/management_background</item>
        <item name="android:navigationBarColor">@color/management_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/management_background</item>
        <item name="android:textColorPrimary">@color/management_text</item>
        <item name="android:textColorSecondary">@color/management_text_secondary</item>
        <item name="android:colorBackground">@color/management_background</item>
        <item name="android:buttonStyle">@style/ManagementButton</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>