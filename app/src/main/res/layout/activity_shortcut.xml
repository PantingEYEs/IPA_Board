<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shortcut_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/management_background">

    <!-- Header with Back Button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shortcut Management"
            android:textSize="@dimen/management_title_size"
            android:textColor="@color/management_text"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/multifunction_bar_title"
        android:textColor="@color/management_text"
        android:textSize="@dimen/management_section_size" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/multifunction_bar_help"
        android:textColor="@color/management_text_secondary"
        android:textSize="@dimen/management_caption_size" />

    <FrameLayout
        android:id="@+id/multifunction_bar_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/management_surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configure key shortcuts for modifier actions"
                android:textColor="@color/management_text_secondary"
                android:textSize="@dimen/management_caption_size"
                android:layout_marginBottom="20dp"/>

            <Button style="@style/ManagementButton"
                android:id="@+id/btn_manage_shift_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shift Shortcuts"
                android:textSize="@dimen/management_caption_size"
                android:layout_marginBottom="16dp" />

            <Button style="@style/ManagementButton"
                android:id="@+id/btn_manage_ctrl_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ctrl Shortcuts"
                android:textSize="@dimen/management_caption_size"
                android:layout_marginBottom="16dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/replacement_title" android:textSize="@dimen/management_section_size"
                android:textColor="@color/management_text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/replacement_help" android:textSize="@dimen/management_caption_size"
                android:textColor="@color/management_text_secondary" android:paddingVertical="8dp" />
            <LinearLayout android:id="@+id/replacement_rules" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>