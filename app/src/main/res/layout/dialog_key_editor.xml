<?xml version="1.0" encoding="utf-8"?>
<com.example.ipa_board.KeyEditorScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/sp_key_type"
            android:text="@string/key_type" />

        <Spinner
            android:id="@+id/sp_key_type"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/tv_key_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp" />

        <Spinner
            android:id="@+id/sp_text_behavior"
            android:contentDescription="@string/text_behavior"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/et_key_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLength="1000"
            android:hint="@string/key_text_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/multifunction_mode"
            android:labelFor="@id/sp_multifunction_mode" />

        <Spinner
            android:id="@+id/sp_multifunction_mode"
            android:contentDescription="@string/multifunction_mode"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <LinearLayout
            android:id="@+id/classic_multifunction_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <Button
            android:id="@+id/btn_long_press_queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/classic_queue_edit" />

        <TextView
            android:id="@+id/tv_long_press_queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/sp_swipe_left_type"
            android:text="@string/swipe_left_type" />

        <Spinner
            android:id="@+id/sp_swipe_left_type"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/et_swipe_left_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLength="1000"
            android:hint="@string/swipe_left_text_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/sp_swipe_right_type"
            android:text="@string/swipe_right_type" />

        <Spinner
            android:id="@+id/sp_swipe_right_type"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/et_swipe_right_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLength="1000"
            android:hint="@string/swipe_right_text_hint" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/popup_multifunction_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_key_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>
</com.example.ipa_board.KeyEditorScrollView>
