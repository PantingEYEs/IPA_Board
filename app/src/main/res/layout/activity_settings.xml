<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keyboard Configuration"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Layout Management -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Layout File"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/sp_layouts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFFFFF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Import"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Export"
                android:textSize="12sp"
                android:layout_marginHorizontal="4dp"/>

            <Button
                android:id="@+id/btn_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit First Key"
                android:textSize="12sp"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_new_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/new_layout"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_clear_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/clear_keys"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_undo_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/undo_clear"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/key_preview_hint"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Live Preview -->
        <FrameLayout
            android:id="@+id/preview_wrapper"
            android:layout_marginBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222">

            <include layout="@layout/keyboard_view" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#444444"
            android:layout_marginBottom="16dp"/>

        <!-- Color Target Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Color Target"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rg_color_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <RadioButton
                android:id="@+id/rb_target_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Background"
                android:textColor="#FFFFFF"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rb_target_symbol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Symbol"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

        <!-- HSL Sliders -->
        <TextView
            android:id="@+id/tv_hue_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hue: 0"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <SeekBar
            android:id="@+id/sb_hue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="360"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_saturation_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saturation: 0%"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <SeekBar
            android:id="@+id/sb_saturation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_lightness_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lightness: 0%"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <SeekBar
            android:id="@+id/sb_lightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:layout_marginBottom="24dp"/>

        <!-- Height Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Keyboard Height"
                android:textColor="#BBBBBB"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/tv_height_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="210dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="300"
            android:progress="60"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
