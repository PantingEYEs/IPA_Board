<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/management_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">

        <!-- Header with Back Button and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clipboard Management"
                android:textSize="@dimen/management_title_size"
                android:textColor="@color/management_text"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Paste Feature Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/management_surface"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Paste Feature"
                        android:textColor="@color/management_text"
                        android:textSize="@dimen/management_body_size"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show latest copied text in status area for quick pasting"
                        android:textColor="@color/management_text_secondary"
                        android:textSize="@dimen/management_caption_size" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_quick_paste"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" android:textSize="@dimen/management_body_size" android:textColor="@color/management_text" />
            </LinearLayout>

            <!-- Nested Options Container for Quick Paste -->
            <LinearLayout
                android:id="@+id/container_quick_paste_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp">

                <!-- Section 1: Retention Time -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Retention Time"
                    android:textColor="@color/management_text_secondary"
                    android:textSize="@dimen/management_caption_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_retention_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/rb_retention_custom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom (0 - 43200 sec): "
                            android:textColor="@color/management_text"
                            android:checked="true" />

                        <EditText
                            android:id="@+id/et_retention_seconds"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="60"
                            android:textColor="@color/management_text"
                            android:textSize="@dimen/management_caption_size"
                            android:background="@color/management_control"
                            android:padding="8dp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" sec"
                            android:textColor="@color/management_text_secondary"
                            android:textSize="@dimen/management_caption_size" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rb_retention_until_disappear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Until it disappears"
                        android:textColor="@color/management_text" />
                </RadioGroup>

                <!-- Section 2: Usage Count Limit -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usage Limit"
                    android:textColor="@color/management_text_secondary"
                    android:textSize="@dimen/management_caption_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_usage_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/rb_usage_custom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom (0 - 100 times): "
                            android:textColor="@color/management_text"
                            android:checked="true" />

                        <EditText
                            android:id="@+id/et_usage_times"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="1"
                            android:textColor="@color/management_text"
                            android:textSize="@dimen/management_caption_size"
                            android:background="@color/management_control"
                            android:padding="8dp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" time(s)"
                            android:textColor="@color/management_text_secondary"
                            android:textSize="@dimen/management_caption_size" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rb_usage_never_exhausted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Never exhausted"
                        android:textColor="@color/management_text" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <!-- SMS OTP Auto-Copy Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/management_surface"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMS OTP Auto-Copy"
                        android:textColor="@color/management_text"
                        android:textSize="@dimen/management_body_size"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Automatically detect SMS OTP verification codes"
                        android:textColor="@color/management_text_secondary"
                        android:textSize="@dimen/management_caption_size" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_sms_otp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" android:textSize="@dimen/management_body_size" android:textColor="@color/management_text" />
            </LinearLayout>

            <!-- Mode Selection Container for SMS OTP -->
            <LinearLayout
                android:id="@+id/container_sms_otp_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Implementation Mode"
                    android:textColor="@color/management_text_secondary"
                    android:textSize="@dimen/management_caption_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_sms_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_sms_mode_autofill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AutoFill (SmsCodeAutoFillClient)"
                        android:textColor="@color/management_text"
                        android:checked="true"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rb_sms_mode_broadcast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Broadcast Mode (SMS Receiver + Local Parser)"
                        android:textColor="@color/management_text" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <Button style="@style/ManagementButton"
            android:id="@+id/btn_save_clipboard_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:textSize="@dimen/management_caption_size" />

    </LinearLayout>
</ScrollView>
