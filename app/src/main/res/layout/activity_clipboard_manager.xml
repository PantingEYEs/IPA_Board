<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clipboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/management_background">
<ScrollView
    android:id="@+id/clipboard_settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/management_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <!-- Header with Back Button and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clipboard Management"
                android:textSize="@dimen/management_title_size"
                android:textColor="@color/management_text"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/management_surface"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <Switch
                android:id="@+id/sw_clipboard_sync_on_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:checked="true"
                android:text="@string/clipboard_startup_sync"
                android:textColor="@color/management_text"
                android:textSize="@dimen/management_body_size" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clipboard_startup_sync_help"
                android:textColor="@color/management_text_secondary"
                android:textSize="@dimen/management_caption_size" />
        </LinearLayout>

        <!-- Quick Paste Feature Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/management_surface"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Paste Feature"
                        android:textColor="@color/management_text"
                        android:textSize="@dimen/management_body_size"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show latest copied text in status area for quick pasting"
                        android:textColor="@color/management_text_secondary"
                        android:textSize="@dimen/management_caption_size" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_quick_paste"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" android:textSize="@dimen/management_body_size" android:textColor="@color/management_text" />
            </LinearLayout>

            <!-- Nested Options Container for Quick Paste -->
            <LinearLayout
                android:id="@+id/container_quick_paste_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp">

                <!-- Section 1: Retention Time -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Retention Time"
                    android:textColor="@color/management_text_secondary"
                    android:textSize="@dimen/management_caption_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_retention_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/rb_retention_custom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom (0 - 43200 sec): "
                            android:textColor="@color/management_text"
                            android:checked="true" />

                        <EditText
                            android:id="@+id/et_retention_seconds"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="60"
                            android:textColor="@color/management_text"
                            android:textSize="@dimen/management_caption_size"
                            android:background="@color/management_control"
                            android:padding="8dp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" sec"
                            android:textColor="@color/management_text_secondary"
                            android:textSize="@dimen/management_caption_size" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rb_retention_until_disappear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Until it disappears"
                        android:textColor="@color/management_text" />
                </RadioGroup>

                <!-- Section 2: Usage Count Limit -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usage Limit"
                    android:textColor="@color/management_text_secondary"
                    android:textSize="@dimen/management_caption_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_usage_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/rb_usage_custom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom (0 - 100 times): "
                            android:textColor="@color/management_text"
                            android:checked="true" />

                        <EditText
                            android:id="@+id/et_usage_times"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="1"
                            android:textColor="@color/management_text"
                            android:textSize="@dimen/management_caption_size"
                            android:background="@color/management_control"
                            android:padding="8dp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" time(s)"
                            android:textColor="@color/management_text_secondary"
                            android:textSize="@dimen/management_caption_size" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rb_usage_never_exhausted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Never exhausted"
                        android:textColor="@color/management_text" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <!-- SMS OTP Auto-Copy Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/management_surface"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMS OTP Auto-Copy"
                        android:textColor="@color/management_text"
                        android:textSize="@dimen/management_body_size"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Automatically detect SMS OTP verification codes"
                        android:textColor="@color/management_text_secondary"
                        android:textSize="@dimen/management_caption_size" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_sms_otp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" android:textSize="@dimen/management_body_size" android:textColor="@color/management_text" />
            </LinearLayout>

            <!-- Mode Selection Container for SMS OTP -->
            <LinearLayout
                android:id="@+id/container_sms_otp_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Implementation Mode"
                    android:textColor="@color/management_text_secondary"
                    android:textSize="@dimen/management_caption_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_sms_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_sms_mode_autofill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AutoFill (SmsCodeAutoFillClient)"
                        android:textColor="@color/management_text"
                        android:checked="true"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rb_sms_mode_broadcast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Broadcast Mode (SMS Receiver + Local Parser)"
                        android:textColor="@color/management_text" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <Button style="@style/ManagementButton"
            android:id="@+id/btn_save_clipboard_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:backgroundTint="@color/management_control"
            app:backgroundTint="@color/management_control"
            android:textColor="@color/management_button_text"
            android:textSize="@dimen/management_caption_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clipboard_history_title"
            android:textColor="@color/management_text"
            android:textSize="@dimen/management_body_size"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/clipboard_batch_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/clipboard_selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/management_text_secondary" />
            <Button style="@style/ManagementButton"
                android:id="@+id/clipboard_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clipboard_select_all" />
            <Button style="@style/ManagementButton"
                android:id="@+id/clipboard_export_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clipboard_export_selected" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/clipboard_history_host"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="80dp" />
    </LinearLayout>
</ScrollView>

    <View
        android:id="@+id/overlay_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/fab_menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="84dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:visibility="gone">
        <Button style="@style/ManagementButton"
            android:id="@+id/btn_batch_manage"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="@string/clipboard_manage" />
        <Button style="@style/ManagementButton"
            android:id="@+id/clipboard_export_menu"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="@string/clipboard_export_selected" />
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/clipboard_actions"
        app:fabSize="normal"
        app:backgroundTint="@color/management_control"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/management_text" />
</FrameLayout>
