<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/management_background"
    android:padding="16dp">

    <!-- Header with Back Button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emoji Management"
            android:textSize="@dimen/management_title_size"
            android:textColor="@color/management_text"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_emoji_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/management_text"
        android:textSize="@dimen/management_body_size"
        android:layout_marginBottom="16dp"/>

    <Button style="@style/ManagementButton"
        android:id="@+id/btn_update_emoji"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/emoji_update_button"
        android:textSize="@dimen/management_caption_size"
        android:layout_marginBottom="16dp" />

</LinearLayout>
